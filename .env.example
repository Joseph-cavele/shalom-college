# Example environment file for Shalom Training School SA (Next.js 15)
# Copy to .env and fill in real values. Safe to commit (no secrets).

# --- Database ---
# MongoDB connection string (local or Atlas). Include the database name.
# MONGODB_URI is also accepted (it takes precedence when both are set).
MONGO_URI=

# --- Auth (Auth.js v5) ---
# Encrypts the session cookie and keys the sign-in code HMAC. Generate with:
#   npx auth secret      (or: openssl rand -base64 32)
# Changing it signs everyone out and invalidates pending codes.
AUTH_SECRET=
# Public URL of the auth API. Optional on Vercel; set it for other hosts.
# AUTH_URL=https://www.shalomtrainingschool.co.za/api/auth

# --- File uploads (Cloudinary) ---
# If these are set, application ID documents upload to Cloudinary;
# otherwise they fall back to local /public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_UPLOAD_SIZE=  # 5MB in bytes

# --- Email (Resend) ---
# Sends owner sign-in codes, owner alerts (new applications & contact messages)
# and applicant confirmations. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Shalom Training School <info@shalomtrainingschool.co.za>"   # FROM_EMAIL also accepted
# Owner inbox for alerts; also the default for `npm run owner:setup`.
OWNER_EMAIL=
# Only read by `npm run owner:setup -- --set-password` (optional backup password).
# OWNER_PASSWORD=

# --- Public ---
# Canonical site address used for SEO links, the logo and link previews
# (defaults to https://www.shalomtrainingschool.co.za).
# NEXT_PUBLIC_SITE_URL=https://www.shalomtrainingschool.co.za
NEXT_PUBLIC_APP_NAME=Shalom Training School
